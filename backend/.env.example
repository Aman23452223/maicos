# --- App ---
APP_NAME=multi-agent-ai-company-os
APP_ENV=dev
APP_SECRET_KEY=change-me
APP_LOG_LEVEL=INFO

# --- Database ---
# Local Postgres (Docker):
#   DATABASE_URL=postgresql+psycopg2://os:os@localhost:5432/os
#
# Supabase (recommended for hosted dev/prod):
#   1. Project → Settings → Database → Connection string → URI
#   2. Use the **Transaction** pooler (port 6543) for the FastAPI app
#      — it handles hundreds of short-lived connections.
#   3. Use the **Direct** connection (port 5432) for Alembic migrations
#      (long-lived, single connection).
#
# Railway Postgres plugin (also supported):
#   1. +New → Database → PostgreSQL
#   2. Postgres card → Variables → Add Reference → maicos service → DATABASE_URL
#
# Example (Supabase, replace <PASSWORD>, <REGION>, <PROJECT_REF>):
#   DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://os:os@localhost:5432/os
VECTOR_BACKEND=pgvector

# --- Job queue & scheduler ---
# MAICOS now uses Postgres itself for the job queue and scheduled-job
# dispatch (via the `workflow_jobs` + `scheduled_jobs` tables, with
# `pg_notify` for wake-up and `pg_cron` for one-minute polling).
# No Redis or APScheduler is required.
#
# To enable the in-process worker (recommended for single-replica
# deployments), leave WORKER_ENABLED=true. Set to false if you run
# the worker as a separate process (`python -m app.workers.scheduler`).
WORKER_ENABLED=true
# Identifier used in the `claimed_by` column for observability.
WORKER_ID=maicos-web-1

# --- LLM Gateway ---
# Provider-independent. Options: openrouter (default), openai, anthropic.
# Paste your key in the UI Settings page (NEVER commit a real key).
LLM_PROVIDER=openrouter
LLM_DEFAULT_MODEL=minimax/minimax-m3:free
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter: obtain at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=minimax/minimax-m3:free

# --- Object storage (documents) ---
DOCUMENT_STORAGE_DIR=./var/documents

# --- CORS ---
# Comma-separated. Wildcards ("*") are accepted in dev only — set
# explicit origins in production (e.g. https://maicos.vercel.app).
CORS_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview URLs (*.vercel.app) and any other
# dynamic hostnames. Leave blank in dev.
CORS_ORIGIN_REGEX=

# --- Autonomy defaults (per §30) ---
DEFAULT_AUTONOMY_LEVEL=2

# --- Approval policies (JSON; per §14) ---
APPROVAL_POLICY_JSON={"send_external_communication":"approval","create_financial_document":"approval","execute_payment":"required","delete_critical_data":"required","change_security_settings":"admin"}

# --- Supabase Auth (optional) ---
# When both are set, the backend verifies Supabase-issued JWTs (RS256)
# and provisions a MAICOS user on first sight. Leave empty to keep
# MAICOS HS256 auth only.
#   - SUPABASE_URL  = https://<project-ref>.supabase.co
#   - SUPABASE_ANON_KEY  = sb_publishable_...   (safe to ship client-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
