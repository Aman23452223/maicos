# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (optional client-side helpers: auth, realtime, storage) ---
# Get from https://supabase.com/dashboard → Project → Settings → API
# Values must start with NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy alias — Supabase still issues some dashboards with this name:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Whether to mount the SupabaseAuthProvider in src/app/layout.tsx
# (set to "true" once the two vars above are populated).
NEXT_PUBLIC_SUPABASE_ENABLED=false
